FROM python:3.11-slim-bookworm

WORKDIR /app

RUN apt-get update && apt-get upgrade -y --no-install-recommends \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements first for caching
COPY requirements_consumer.txt .
RUN pip install --no-cache-dir --timeout 120 --retries 5 -r requirements_consumer.txt

# Copy source code
COPY src/ ./src/

# Create models directory
RUN mkdir -p /app/models

# Run the consumer
CMD ["python", "-m", "src.streaming.consumer", "--mode", "local", "--model", "/app/models/fraud_model.joblib", "--config", "/app/models/feature_config.json"]
